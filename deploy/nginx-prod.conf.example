# nginx server block for the PRODUCTION domain.
#
# Save as /etc/nginx/sites-available/tester-lab, then:
#   ln -s /etc/nginx/sites-available/tester-lab /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d tester-lab.mibot.my.id     # issue SSL
#
# Adjust the upstream port to match PORT in the production .env (default 3000).

server {
    listen 80;
    server_name tester-lab.mibot.my.id;

    # ── Body size limit ──────────────────────────────────────────────
    # Must be large enough for feedback attachments sent as base64
    # inside JSON bodies. A 5 MB image becomes ~6.7 MB after base64
    # encoding, plus JSON overhead. 20m provides comfortable headroom.
    # Without this, Nginx returns 413 Request Entity Too Large.
    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
