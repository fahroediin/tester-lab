# Tester Lab Server Configuration
PORT=3000
HOST=0.0.0.0

# Super Admin Account Configuration
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@testerlab.com
ADMIN_PASSWORD=AdminPassword123!

# JWT Security
JWT_SECRET=tester-lab-jwt-secret-key-2026-secure

# Playwright & Concurrency Configuration
# Timeout in milliseconds for Playwright test runs (default: 120000 = 2 minutes)
PLAYWRIGHT_TIMEOUT=120000

# Maximum simultaneous test execution processes running in parallel (default: 3)
MAX_CONCURRENT_TESTS=3

# Maximum simultaneous test code generation processes running in parallel (default: 5)
MAX_CONCURRENT_GENERATIONS=5

# Feedback Configuration
# Max file size in bytes for feedback attachments (default: 5242880 = 5MB)
MAX_FEEDBACK_FILE_SIZE=5242880

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
