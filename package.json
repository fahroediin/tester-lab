{
  "name": "tester-lab",
  "version": "1.0.0",
  "description": "Non-LLM Rule & Heuristic Based Automated Test Script Generator",
  "main": "dist/index.js",
  "bin": {
    "test-gen": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').mkdirSync('dist/templates', {recursive: true}); require('fs').cpSync('src/templates', 'dist/templates', {recursive: true}); require('fs').mkdirSync('dist/public', {recursive: true}); require('fs').cpSync('public', 'dist/public', {recursive: true});\"",
    "start": "node dist/server/index.js",
    "cli": "ts-node src/cli/index.ts",
    "demo": "ts-node examples/demo-server.ts",
    "generate": "ts-node src/cli/index.ts generate"
  },
  "keywords": [
    "testing",
    "playwright",
    "test-generator",
    "heuristic",
    "non-llm",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@playwright/test": "^1.45.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/dotenv": "^6.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "commander": "^12.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "fast-levenshtein": "^3.0.0",
    "handlebars": "^4.7.8",
    "js-yaml": "^5.4.0",
    "jsonwebtoken": "^9.0.3",
    "playwright": "^1.45.0",
    "prettier": "^3.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
