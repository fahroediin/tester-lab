// Helper to create dynamic TestObject from XPath or CSS selector
TestObject makeTestObject(String selector, String type = 'xpath') {
    TestObject to = new TestObject()
    to.addProperty(type, ConditionType.EQUALS, selector)
    return to
}

// Helper to wait for URL to match pattern (handles SPA asynchronous redirects)
boolean waitForUrl(String pattern, int timeoutSeconds = 10) {
    long endTime = System.currentTimeMillis() + (timeoutSeconds * 1000)
    while (System.currentTimeMillis() < endTime) {
        String currentUrl = WebUI.getUrl()
        if (currentUrl != null && currentUrl.matches(pattern)) {
            return true
        }
        WebUI.delay(1)
    }
    return false
}

