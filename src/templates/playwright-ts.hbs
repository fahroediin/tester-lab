import { test, expect, type Locator } from '@playwright/test';

test('{{jsLit testSuite}}', async ({ page }) => {
  // Set explicit timeout for long E2E flows
  test.setTimeout({{testTimeout}});

  // Set viewport if configured
  {{#if viewport}}
  await page.setViewportSize({ width: {{viewport.width}}, height: {{viewport.height}} });
  {{/if}}

  // Navigate to target URL
  await page.goto('{{jsLit targetUrl}}');
  await page.waitForLoadState('networkidle');

  // Maestro-like Auto-Wait and Scroll-Until-Visible Engine
  const maestro = {
    // The last element an assert confirmed; highlighted in the success snapshot
    // so a viewer sees exactly what was found and matched.
    lastAssertLocator: null as Locator | null,
    // On a passing run, capture one snapshot at the end. If an assert ran,
    // outline that element first so the match is visible; otherwise capture the
    // final page state plainly. Never throws (evidence must not fail a run).
    async captureSuccess() {
      try {
        const target = this.lastAssertLocator;
        if (target) {
          await target.evaluate((el: Element) => {
            const h = el as HTMLElement;
            h.style.outline = '3px solid #ff5b5b';
            h.style.outlineOffset = '2px';
            h.style.boxShadow = '0 0 0 4px rgba(255,91,91,0.35)';
            h.style.backgroundColor = 'rgba(255, 235, 59, 0.35)'; // fill so the block reads clearly
            // Table rows ignore background on <tr> in some engines; tint cells too.
            h.querySelectorAll('td, th').forEach((c) => { (c as HTMLElement).style.backgroundColor = 'rgba(255, 235, 59, 0.35)'; });
            h.scrollIntoView({ block: 'center', behavior: 'instant' as ScrollBehavior });
          }).catch(() => {});
        }
        // Write into the test's output dir so the runner's findScreenshotFile
        // (which scans the temp results tree for a .png) picks it up.
        const shotPath = test.info().outputPath('success-snapshot.png');
        await page.screenshot({ path: shotPath, fullPage: false }).catch(() => {});
      } catch { /* evidence is best-effort */ }
    },
    // Per-step evidence (US-19): one screenshot per step, named step_<N>.png so
    // the runner's collectStepScreenshots can gather them in order. Called AFTER
    // a step's action succeeds, so it shows what that step did. Best-effort.
    async captureStep(n: number) {
      try {
        await page.screenshot({ path: test.info().outputPath('step_' + n + '.png'), fullPage: false }).catch(() => {});
      } catch { /* best-effort */ }
    },
    // A step's evidence at the MOMENT it first fails — taken before the retry
    // loop scrolls the page around or an idle timeout redirects it (e.g. back to
    // login). If the asserted element is present it is outlined so the viewer
    // sees what was checked; otherwise the page state at failure is captured.
    async captureStepFailure(n: number, locator: Locator | null) {
      try {
        let outlined = false;
        if (locator) {
          const found = await locator.first().count().catch(() => 0);
          if (found > 0) {
            outlined = true;
            await locator.first().evaluate((el: Element) => {
              const h = el as HTMLElement;
              h.style.outline = '3px solid #ff5b5b';
              h.style.outlineOffset = '2px';
              h.style.boxShadow = '0 0 0 4px rgba(255,91,91,0.35)';
              h.scrollIntoView({ block: 'center', behavior: 'instant' as ScrollBehavior });
            }).catch(() => {});
          }
        }
        // Nothing to outline (the asserted text/element is absent): overlay a
        // deterministic banner naming what was searched for, so the snapshot
        // says why it failed without guessing at a similar element.
        let banner = false;
        if (!outlined && this.currentTarget) {
          await page.evaluate((target: string) => {
            const b = document.createElement('div');
            b.id = '__tl_fail_banner';
            b.textContent = 'Dicari: ' + target + ' — TIDAK DITEMUKAN';
            b.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:2147483647;' +
              'background:#ff5b5b;color:#fff;font:600 14px/1.4 system-ui,sans-serif;' +
              'padding:10px 16px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,0.3);';
            document.body.appendChild(b);
          }, this.currentTarget).catch(() => {});
          banner = true;
        }
        await page.screenshot({ path: test.info().outputPath('step_' + n + '.png'), fullPage: false }).catch(() => {});
        // Remove the banner right away: it contains the searched text, so if it
        // lingered the next retry's getByText() would match the banner itself
        // and the assertion would pass falsely.
        if (banner) {
          await page.evaluate(() => { const b = document.getElementById('__tl_fail_banner'); if (b) b.remove(); }).catch(() => {});
        }
      } catch { /* best-effort */ }
    },
    // The step number currently executing; set by the test body before each
    // step so interact() can name this step's evidence without threading the
    // number through every generated call.
    currentStep: 0 as number,
    // What the current step is looking for (assert target / value), used to
    // label the failure snapshot when the element is absent.
    currentTarget: '' as string,
    async interact(locator: Locator, action: 'click' | 'fill' | 'select' | 'check' | 'uncheck' | 'upload' | 'assert_visible' | 'assert_text' | 'assert_value', value?: string, expectedText?: string, fieldLabel?: string) {
      let lastError;
      let failureCaptured = false;
      // What this step searches for, for the failure banner: the asserted text
      // (assert_text/value), else the filled value, else the field label.
      this.currentTarget = expectedText || value || fieldLabel || '';
      for (let i = 0; i < 15; i++) {
        try {
          await locator.first().waitFor({ state: 'attached', timeout: 1500 });
          
          if (action === 'click') {
            await locator.first().click({ force: true, timeout: 2000 });
          } else if (action === 'fill') {
            await locator.first().fill(value!, { force: true, timeout: 2000 });
          } else if (action === 'select') {
            await locator.first().selectOption(value!, { force: true, timeout: 2000 });
          } else if (action === 'check') {
            await locator.first().check({ force: true, timeout: 2000 });
          } else if (action === 'uncheck') {
            await locator.first().uncheck({ force: true, timeout: 2000 });
          } else if (action === 'upload') {
            await locator.first().setInputFiles(value!, { timeout: 2000 });
          } else if (action === 'assert_visible') {
            await expect(locator.first()).toBeVisible({ timeout: 2000 });
            this.lastAssertLocator = locator.first(); // remember for the success snapshot
          } else if (action === 'assert_text') {
            await expect(locator.first()).toContainText(new RegExp(expectedText || '', 'i'), { timeout: 2000 });
            this.lastAssertLocator = locator.first();
          } else if (action === 'assert_value') {
            const count = await locator.count();
            if (count === 0) { const e: any = new Error(`No field labeled "${fieldLabel || ''}" was found on the page.`); e.assertValueFinal = true; throw e; }
            const actual = await locator.first().inputValue({ timeout: 2000 });
            const needle = (expectedText || '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            if (!new RegExp(needle, 'i').test(actual)) {
              const e: any = new Error(`Field "${fieldLabel || ''}" value "${actual}" does not contain the expected "${expectedText || ''}".`);
              e.assertValueFinal = true;
              throw e;
            }
            this.lastAssertLocator = locator.first();
          }
          return; // Success
        } catch (e: any) {
          lastError = e;
          // Capture this step's evidence at the FIRST failure, before the retry
          // loop scrolls the page or an idle redirect changes it (US-19). Only
          // once; a definitive assert_value verdict also gets a shot before it
          // surfaces verbatim.
          if (!failureCaptured && this.currentStep > 0) {
            failureCaptured = true;
            await this.captureStepFailure(this.currentStep, locator);
          }
          if (e && e.assertValueFinal) throw e;
          // Scroll down slightly if element is not interactable or not found
          await page.evaluate(() => window.scrollBy(0, 400));
          await page.waitForTimeout(300); // Allow lazy-loaded elements to render
        }
      }
      throw new Error(`Maestro Auto-Scroll Timeout: Element not found or interactable. Last error: ${lastError?.message}`);
    },
    // Assert a text appears anywhere on the page: as visible text OR as the
    // value of an input/textarea/select. Lets "800.000" match "Rp 800.000"
    // shown inside a readonly input, without the user naming the field.
    async assertTextOnPage(needle: string): Promise<void> {
      this.currentTarget = needle; // for the not-found failure banner
      const re = new RegExp(needle.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'i');
      let failureCaptured = false;
      for (let i = 0; i < 15; i++) {
        // 1) visible text node
        if (await page.getByText(re).count() > 0) return;
        // 2) value of any field
        const values = await page.locator('input, textarea, select').evaluateAll(
          (els) => els.map((el) => (el as HTMLInputElement).value || '')
        );
        if (values.some((v) => re.test(v))) return;
        // First miss: capture this step's evidence now (before the scroll/retry
        // loop changes the page) with a "not found" banner. locator is null so
        // captureStepFailure overlays the banner instead of outlining.
        if (!failureCaptured && this.currentStep > 0) {
          failureCaptured = true;
          await this.captureStepFailure(this.currentStep, null);
        }
        await page.evaluate(() => window.scrollBy(0, 400));
        await page.waitForTimeout(300);
      }
      throw new Error(`Text "${needle}" was not found on the page (checked visible text and field values).`);
    },
    // US-36: resolve the single row/card that contains a unique marker text.
    // Throws the not-found (AC-36.04) or not-unique (AC-36.05) message.
    scopedRow(marker: string): Locator {
      const byRole = page.getByRole('row', { name: new RegExp(marker.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'i') });
      const byFilter = page.locator('tr, li, [role="row"]').filter({ hasText: marker });
      return {
        locator: (sel: string) => byRole.or(byFilter).first().locator(sel),
        getByRole: (role: string, opts?: { name?: RegExp | string }) => byRole.or(byFilter).first().getByRole(role as Parameters<Locator['getByRole']>[0], opts as Parameters<Locator['getByRole']>[1]),
        getByText: (text: RegExp | string) => byRole.or(byFilter).first().getByText(text),
        getByTestId: (id: string) => byRole.or(byFilter).first().getByTestId(id),
        getByPlaceholder: (text: RegExp | string) => byRole.or(byFilter).first().getByPlaceholder(text),
        getByLabel: (text: RegExp | string) => byRole.or(byFilter).first().getByLabel(text),
        async assertResolvable() {
          // Poll for the row: content loaded async after navigation (e.g. an
          // order list fetched right after login) may not be rendered yet on
          // the first tick. A single count() then races that load and reports a
          // false "not found". Wait until exactly one row appears, or until the
          // window elapses, then give the honest verdict (AC-36.04/05).
          let count = 0;
          for (let i = 0; i < 20; i++) {
            count = await byRole.or(byFilter).count();
            if (count === 1) { maestro.lastAssertLocator = byRole.or(byFilter).first(); return; } // matched row -> highlight it
            if (count > 1) break;         // ambiguous now; more time won't help
            await page.waitForTimeout(300); // count === 0: give async data time to render
          }
          if (count === 0) throw new Error(`No row containing "${marker}" was found on the page.`);
          throw new Error(`Scope marker "${marker}" matched more than one row. Use a unique value such as an ID so the step targets exactly one row.`);
        }
      } as unknown as Locator;
    }
  };

  {{#if needsRobustHelper}}
  // Helper for dynamic form locators (OutSystems/Complex UI)
  async function legacyAction(type: 'select' | 'fill', label: string, value: string) {
    const tag = type === 'select' ? 'select' : 'input';
    const escapedLabel = label.replace(/'/g, "\\'");
    const xpath = `xpath=((//*[normalize-space(.)='${escapedLabel}' or normalize-space(.)='${escapedLabel} *' or normalize-space(.)='${escapedLabel}*'])[1]/following::${tag}[1] | (//*[normalize-space(.)='${escapedLabel}' or normalize-space(.)='${escapedLabel} *' or normalize-space(.)='${escapedLabel}*'])[1]//${tag})[1]`;
    const target = page.locator(xpath);
    await maestro.interact(target, type, value);
  }
  {{/if}}

  {{#each resolvedSteps}}
  maestro.currentStep = {{step}};
  console.log('__STEP_START__ {{step}}');
  // Step {{step}}: {{#if description}}{{jsLit description}}{{else}}{{action}} -> {{jsLit targetLabel}}{{/if}}
  {{#if warning}}
  // [WARNING]: {{jsLit warning}}
  {{/if}}
  
  {{#if (eq action "fill")}}
    {{#if (eq selectorType "getByTestId")}}
  await maestro.interact(page.getByTestId('{{jsLit selectorValue}}'), 'fill', '{{jsLit value}}');
    {{else if (eq selectorType "getByLabel")}}
  await maestro.interact(page.getByLabel(new RegExp('{{{escapeRegex selectorValue}}}', 'i')), 'fill', '{{jsLit value}}');
    {{else if (eq selectorType "getByRole")}}
  await maestro.interact(page.getByRole('{{jsLit selectorValue}}', { name: new RegExp('{{{escapeRegex roleName}}}', 'i') }), 'fill', '{{jsLit value}}');
    {{else if (eq selectorType "getByPlaceholder")}}
  await maestro.interact(page.getByPlaceholder(new RegExp('{{{escapeRegex selectorValue}}}', 'i')), 'fill', '{{jsLit value}}');
    {{else if (eq selectorType "getByText")}}
  await maestro.interact(page.getByText(new RegExp('{{{escapeRegex selectorValue}}}', 'i')), 'fill', '{{jsLit value}}');
    {{else}}
      {{#if ../needsRobustHelper}}
        {{#if targetLabel}}
  await legacyAction('fill', '{{jsLit targetLabel}}', '{{jsLit value}}');
        {{else}}
  await maestro.interact(page.locator('{{jsLit selectorValue}}'), 'fill', '{{jsLit value}}');
        {{/if}}
      {{else}}
  await maestro.interact(page.locator('{{jsLit selectorValue}}'), 'fill', '{{jsLit value}}');
      {{/if}}
    {{/if}}
  {{/if}}

  {{#if (eq action "click")}}
    {{#if options.within}}
  await maestro.scopedRow('{{jsLit options.within}}').assertResolvable();
    {{/if}}
    {{#if (eq selectorType "getByTestId")}}
  await maestro.interact({{{scopedLoc (concat "page.getByTestId('" (jsLit selectorValue) "')") options.within}}}, 'click');
    {{else if (eq selectorType "getByLabel")}}
  await maestro.interact({{{scopedLoc (concat "page.getByLabel(new RegExp('" (escapeRegex selectorValue) "', 'i'))") options.within}}}, 'click');
    {{else if (eq selectorType "getByRole")}}
  await maestro.interact({{{scopedLoc (concat "page.getByRole('" (jsLit selectorValue) "', { name: new RegExp('" (escapeRegex roleName) "', 'i') })") options.within}}}, 'click');
    {{else if (eq selectorType "getByPlaceholder")}}
  await maestro.interact({{{scopedLoc (concat "page.getByPlaceholder(new RegExp('" (escapeRegex selectorValue) "', 'i'))") options.within}}}, 'click');
    {{else if (eq selectorType "getByText")}}
  await maestro.interact({{{scopedLoc (concat "page.getByText(new RegExp('" (escapeRegex selectorValue) "', 'i'))") options.within}}}, 'click');
    {{else}}
  await maestro.interact({{{scopedLoc (concat "page.locator('" (jsLit selectorValue) "')") options.within}}}, 'click');
    {{/if}}
  {{/if}}

  {{#if (eq action "select")}}
    {{#if (eq selectorType "getByTestId")}}
  await maestro.interact(page.getByTestId('{{jsLit selectorValue}}'), 'select', '{{jsLit value}}');
    {{else if (eq selectorType "getByLabel")}}
  await maestro.interact(page.getByLabel(new RegExp('{{{escapeRegex selectorValue}}}', 'i')), 'select', '{{jsLit value}}');
    {{else}}
      {{#if ../needsRobustHelper}}
        {{#if targetLabel}}
  await legacyAction('select', '{{jsLit targetLabel}}', '{{jsLit value}}');
        {{else}}
  await maestro.interact(page.locator('{{jsLit selectorValue}}'), 'select', '{{jsLit value}}');
        {{/if}}
      {{else}}
  await maestro.interact(page.locator('{{jsLit selectorValue}}'), 'select', '{{jsLit value}}');
      {{/if}}
    {{/if}}
  {{/if}}

  {{#if (eq action "check")}}
    {{#if (eq selectorType "getByTestId")}}
  await maestro.interact(page.getByTestId('{{jsLit selectorValue}}'), 'check');
    {{else if (eq selectorType "getByLabel")}}
  await maestro.interact(page.getByLabel(new RegExp('{{{escapeRegex selectorValue}}}', 'i')), 'check');
    {{else if (eq selectorType "getByRole")}}
  await maestro.interact(page.getByRole('{{jsLit selectorValue}}', { name: new RegExp('{{{escapeRegex roleName}}}', 'i') }), 'check');
    {{else}}
  await maestro.interact(page.locator('{{jsLit selectorValue}}'), 'check');
    {{/if}}
  {{/if}}

  {{#if (eq action "uncheck")}}
    {{#if (eq selectorType "getByTestId")}}
  await maestro.interact(page.getByTestId('{{jsLit selectorValue}}'), 'uncheck');
    {{else if (eq selectorType "getByLabel")}}
  await maestro.interact(page.getByLabel(new RegExp('{{{escapeRegex selectorValue}}}', 'i')), 'uncheck');
    {{else}}
  await maestro.interact(page.locator('{{jsLit selectorValue}}'), 'uncheck');
    {{/if}}
  {{/if}}

  {{#if (eq action "upload")}}
    {{#if (eq selectorType "getByTestId")}}
  await maestro.interact(page.getByTestId('{{jsLit selectorValue}}'), 'upload', '{{jsLit value}}');
    {{else if (eq selectorType "getByLabel")}}
  await maestro.interact(page.getByLabel(new RegExp('{{{escapeRegex selectorValue}}}', 'i')), 'upload', '{{jsLit value}}');
    {{else if (eq selectorType "getByRole")}}
  await maestro.interact(page.getByRole('{{jsLit selectorValue}}', { name: new RegExp('{{{escapeRegex roleName}}}', 'i') }), 'upload', '{{jsLit value}}');
    {{else if (eq selectorType "getByPlaceholder")}}
  await maestro.interact(page.getByPlaceholder(new RegExp('{{{escapeRegex selectorValue}}}', 'i')), 'upload', '{{jsLit value}}');
    {{else}}
  await maestro.interact(page.locator('{{jsLit selectorValue}}'), 'upload', '{{jsLit value}}');
    {{/if}}
  {{/if}}

  {{#if (eq action "assert_url")}}
  await expect(page).toHaveURL(new RegExp('{{{escapeRegex selectorValue}}}', 'i'));
  {{/if}}

  {{#if (eq action "assert_text")}}
    {{#if (eq selectorType "getByTestId")}}
  await maestro.interact(page.getByTestId('{{jsLit selectorValue}}'), 'assert_text', undefined, '{{jsLit expected}}');
    {{else if (eq selectorType "getByLabel")}}
  await maestro.interact(page.getByLabel(new RegExp('{{{escapeRegex selectorValue}}}', 'i')), 'assert_text', undefined, '{{jsLit expected}}');
    {{else if (eq selectorType "getByRole")}}
  await maestro.interact(page.getByRole('{{jsLit selectorValue}}', { name: new RegExp('{{{escapeRegex roleName}}}', 'i') }), 'assert_text', undefined, '{{jsLit expected}}');
    {{else if (eq selectorType "getByPlaceholder")}}
  await maestro.interact(page.getByPlaceholder(new RegExp('{{{escapeRegex selectorValue}}}', 'i')), 'assert_text', undefined, '{{jsLit expected}}');
    {{else if (eq selectorType "getByText")}}
  await maestro.interact(page.getByText(new RegExp('{{{escapeRegex selectorValue}}}', 'i')), 'assert_text', undefined, '{{jsLit expected}}');
    {{else if (eq selectorType "pageText")}}
  await maestro.assertTextOnPage('{{jsLit selectorValue}}');
    {{else}}
  await maestro.interact(page.locator('{{jsLit selectorValue}}'), 'assert_text', undefined, '{{jsLit expected}}');
    {{/if}}
  {{/if}}

  {{#if (eq action "assert_visible")}}
    {{#if (eq selectorType "getByTestId")}}
  await maestro.interact(page.getByTestId('{{jsLit selectorValue}}'), 'assert_visible', undefined, '{{jsLit selectorValue}}');
    {{else if (eq selectorType "getByLabel")}}
  await maestro.interact(page.getByLabel(new RegExp('{{{escapeRegex selectorValue}}}', 'i')), 'assert_visible', undefined, '{{jsLit selectorValue}}');
    {{else if (eq selectorType "getByRole")}}
  await maestro.interact(page.getByRole('{{jsLit selectorValue}}', { name: new RegExp('{{{escapeRegex roleName}}}', 'i') }), 'assert_visible', undefined, '{{jsLit roleName}}');
    {{else if (eq selectorType "getByPlaceholder")}}
  await maestro.interact(page.getByPlaceholder(new RegExp('{{{escapeRegex selectorValue}}}', 'i')), 'assert_visible', undefined, '{{jsLit selectorValue}}');
    {{else if (eq selectorType "getByText")}}
  await maestro.interact(page.getByText(new RegExp('{{{escapeRegex selectorValue}}}', 'i')), 'assert_visible', undefined, '{{jsLit selectorValue}}');
    {{else if (eq selectorType "pageText")}}
  await maestro.assertTextOnPage('{{jsLit selectorValue}}');
    {{else}}
  await maestro.interact(page.locator('{{jsLit selectorValue}}'), 'assert_visible', undefined, '{{jsLit selectorValue}}');
    {{/if}}
  {{/if}}

  {{#if (eq action "assert_value")}}
    {{#if (eq selectorType "getByTestId")}}
  await maestro.interact(page.getByTestId('{{jsLit selectorValue}}'), 'assert_value', undefined, '{{jsLit expected}}', '{{jsLit targetLabel}}');
    {{else if (eq selectorType "getByLabel")}}
  await maestro.interact(page.getByLabel(new RegExp('{{{escapeRegex selectorValue}}}', 'i')), 'assert_value', undefined, '{{jsLit expected}}', '{{jsLit targetLabel}}');
    {{else if (eq selectorType "getByRole")}}
  await maestro.interact(page.getByRole('{{jsLit selectorValue}}', { name: new RegExp('{{{escapeRegex roleName}}}', 'i') }), 'assert_value', undefined, '{{jsLit expected}}', '{{jsLit targetLabel}}');
    {{else if (eq selectorType "getByPlaceholder")}}
  await maestro.interact(page.getByPlaceholder(new RegExp('{{{escapeRegex selectorValue}}}', 'i')), 'assert_value', undefined, '{{jsLit expected}}', '{{jsLit targetLabel}}');
    {{else}}
  await maestro.interact(page.locator('{{jsLit selectorValue}}'), 'assert_value', undefined, '{{jsLit expected}}', '{{jsLit targetLabel}}');
    {{/if}}
  {{/if}}

  {{#if (eq action "wait")}}
  await page.waitForTimeout({{selectorValue}});
  {{/if}}

  console.log('__STEP_DONE__ {{step}}');
  // Per-step evidence after the step succeeded (US-19): shows what it did.
  await maestro.captureStep({{step}});
  {{/each}}

  // All steps passed: capture the success snapshot (highlights the last assert).
  await maestro.captureSuccess();
});
