describe('{{jsLit testSuite}}', () => {
  it('should execute business scenario steps successfully', () => {
    // Navigate to target URL
    cy.visit('{{jsLit targetUrl}}');

    {{#each resolvedSteps}}
    // Step {{step}}: {{jsLit description}}
    {{#if warning}}
    // [WARNING]: {{jsLit warning}}
    {{/if}}
    {{#if (eq action "fill")}}
      {{#if (eq selectorType "getByTestId")}}
    cy.get('[data-testid="{{jsLit selectorValue}}"]').clear().type('{{jsLit value}}');
      {{else if (eq selectorType "getByLabel")}}
    cy.contains('label', '{{jsLit selectorValue}}').parent().find('input, textarea').clear().type('{{jsLit value}}');
      {{else if (eq selectorType "getByPlaceholder")}}
    cy.get('[placeholder="{{jsLit selectorValue}}"]').clear().type('{{jsLit value}}');
      {{else}}
    cy.get('{{jsLit selectorValue}}').clear().type('{{jsLit value}}');
      {{/if}}
    {{/if}}
    {{#if (eq action "click")}}
      {{#if (eq selectorType "getByRole")}}
    cy.contains('button, a', '{{jsLit roleName}}').click();
      {{else if (eq selectorType "getByText")}}
    cy.contains('{{jsLit selectorValue}}').click();
      {{else if (eq selectorType "getByTestId")}}
    cy.get('[data-testid="{{jsLit selectorValue}}"]').click();
      {{else}}
    cy.get('{{jsLit selectorValue}}').click();
      {{/if}}
    {{/if}}
    {{#if (eq action "select")}}
    cy.get('{{jsLit selectorValue}}').select('{{jsLit value}}');
    {{/if}}
    {{#if (eq action "check")}}
    cy.get('{{jsLit selectorValue}}').check();
    {{/if}}
    {{#if (eq action "uncheck")}}
    cy.get('{{jsLit selectorValue}}').uncheck();
    {{/if}}
    {{#if (eq action "upload")}}
    cy.get('{{jsLit selectorValue}}').selectFile('{{jsLit value}}');
    {{/if}}
    {{#if (eq action "assert_url")}}
    cy.url().should('include', '{{jsLit selectorValue}}');
    {{/if}}
    {{#if (eq action "assert_text")}}
    cy.contains('{{jsLit expected}}').should('be.visible');
    {{/if}}
    {{#if (eq action "assert_visible")}}
    cy.get('{{jsLit selectorValue}}').should('be.visible');
    {{/if}}
    {{#if (eq action "wait")}}
    cy.wait({{jsLit selectorValue}});
    {{/if}}
    {{/each}}
  });
});
