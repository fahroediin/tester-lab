const { test, expect } = require('@playwright/test');

test('{{jsLit testSuite}}', async ({ page }) => {
  {{#if viewport}}
  await page.setViewportSize({ width: {{viewport.width}}, height: {{viewport.height}} });
  {{/if}}

  await page.goto('{{jsLit targetUrl}}');
  await page.waitForLoadState('networkidle');

  // Success-snapshot engine: remembers the last asserted/matched element and,
  // on a passing run, captures one snapshot with that element outlined so a
  // viewer sees what was found and matched. Never throws (evidence best-effort).
  const maestro = {
    lastAssertLocator: null,
    async captureSuccess() {
      try {
        const target = this.lastAssertLocator;
        if (target) {
          await target.evaluate((el) => {
            el.style.outline = '3px solid #ff5b5b';
            el.style.outlineOffset = '2px';
            el.style.boxShadow = '0 0 0 4px rgba(255,91,91,0.35)';
            el.style.backgroundColor = 'rgba(255, 235, 59, 0.35)';
            el.querySelectorAll('td, th').forEach((c) => { c.style.backgroundColor = 'rgba(255, 235, 59, 0.35)'; });
            el.scrollIntoView({ block: 'center', behavior: 'instant' });
          }).catch(() => {});
        }
        const shotPath = test.info().outputPath('success-snapshot.png');
        await page.screenshot({ path: shotPath, fullPage: false }).catch(() => {});
      } catch (e) { /* evidence is best-effort */ }
    },
    // Per-step evidence (US-19): one screenshot per step (step_<N>.png), taken
    // after the step's action. Best-effort; never fails the run.
    async captureStep(n) {
      try {
        await page.screenshot({ path: test.info().outputPath('step_' + n + '.png'), fullPage: false }).catch(() => {});
      } catch (e) { /* best-effort */ }
    },
    // The step number and searched target for a failure banner.
    currentStep: 0,
    currentTarget: '',
    // Failure evidence: overlay a "not found" banner naming the searched target
    // (the JS asserts run inline, so there is no element to outline here).
    async captureStepFailure(n) {
      try {
        let banner = false;
        if (this.currentTarget) {
          await page.evaluate((target) => {
            const b = document.createElement('div');
            b.id = '__tl_fail_banner';
            b.textContent = 'Dicari: ' + target + ' — TIDAK DITEMUKAN';
            b.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:2147483647;' +
              'background:#ff5b5b;color:#fff;font:600 14px/1.4 system-ui,sans-serif;' +
              'padding:10px 16px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,0.3);';
            document.body.appendChild(b);
          }, this.currentTarget).catch(() => {});
          banner = true;
        }
        await page.screenshot({ path: test.info().outputPath('step_' + n + '.png'), fullPage: false }).catch(() => {});
        // Remove the banner immediately: it contains the searched text, so a
        // lingering banner would make the next retry match itself (false pass).
        if (banner) {
          await page.evaluate(() => { const b = document.getElementById('__tl_fail_banner'); if (b) b.remove(); }).catch(() => {});
        }
      } catch (e) { /* best-effort */ }
    }
  };

  // US-36: resolve the single row/card that contains a unique marker text.
  // Throws the not-found (AC-36.04) or not-unique (AC-36.05) message.
  function scopedRow(marker) {
    // US-36 (extended): a table row, list item, or form group (div/section/
    // fieldset) carrying the marker text. The deepest match is the smallest
    // container, so a marker label scopes to its own field group, not the page.
    const byRole = page.getByRole('row', { name: new RegExp(marker.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'i') });
    const byFilter = page.locator('tr, li, [role="row"], div, section, fieldset').filter({ hasText: marker }).last();
    const base = byRole.or(byFilter).first();
    base.assertResolvable = async () => {
      // Poll for the scope; give the honest verdict (AC-36.04 not-found /
      // AC-36.05 not-unique). Uniqueness is judged by how many places carry the
      // marker text, since nested <div>s inflate the container count.
      const markerText = page.getByText(marker, { exact: false });
      let count = 0;
      for (let i = 0; i < 20; i++) {
        const rows = await byRole.count();
        count = rows > 0 ? rows : await markerText.count();
        if (count === 1) { maestro.lastAssertLocator = base; return; } // matched -> highlight it
        if (count > 1) break;
        await page.waitForTimeout(300);
      }
      if (count === 0) throw new Error(`No row containing "${marker}" was found on the page.`);
      throw new Error(`Scope marker "${marker}" matched more than one row. Use a unique value such as an ID so the step targets exactly one row.`);
    };
    return base;
  }

  // Assert a text appears anywhere on the page: as visible text OR as the
  // value of an input/textarea/select (so "800.000" matches "Rp 800.000" in a
  // readonly field without naming it).
  async function assertTextOnPage(needle) {
    maestro.currentTarget = needle;
    const re = new RegExp(needle.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'i');
    let failureCaptured = false;
    for (let i = 0; i < 15; i++) {
      if (await page.getByText(re).count() > 0) return;
      const values = await page.locator('input, textarea, select').evaluateAll(
        (els) => els.map((el) => el.value || '')
      );
      if (values.some((v) => re.test(v))) return;
      if (!failureCaptured && maestro.currentStep > 0) {
        failureCaptured = true;
        await maestro.captureStepFailure(maestro.currentStep);
      }
      await page.evaluate(() => window.scrollBy(0, 400));
      await page.waitForTimeout(300);
    }
    throw new Error(`Text "${needle}" was not found on the page (checked visible text and field values).`);
  }

  // US-07: verify a field's value contains the expected text (reads value even
  // for disabled/readonly fields). Throws AC-07.08 / AC-07.09 messages.
  async function assertFieldValue(locator, expected, fieldLabel) {
    const count = await locator.count();
    if (count === 0) throw new Error(`No field labeled "${fieldLabel || ''}" was found on the page.`);
    const actual = await locator.first().inputValue({ timeout: 2000 });
    const needle = (expected || '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    if (!new RegExp(needle, 'i').test(actual)) {
      throw new Error(`Field "${fieldLabel || ''}" value "${actual}" does not contain the expected "${expected || ''}".`);
    }
  }

  {{#if needsRobustHelper}}
  async function action(type, label, value) {
    const tag = type === 'select' ? 'select' : 'input';
    const escapedLabel = label.replace(/'/g, "\\'");
    
    // Standard XPath targeting following elements or descendants (handles labels wrapping inputs)
    const xpath = `xpath=((//*[normalize-space(.)='${escapedLabel}' or normalize-space(.)='${escapedLabel} *' or normalize-space(.)='${escapedLabel}*'])[1]/following::${tag}[1] | (//*[normalize-space(.)='${escapedLabel}' or normalize-space(.)='${escapedLabel} *' or normalize-space(.)='${escapedLabel}*'])[1]//${tag})[1]`;
    
    const target = page.locator(xpath);
    await target.waitFor({ state: 'attached', timeout: 15000 });
    
    if (type === 'select') {
      await target.selectOption(value, { force: true });
    } else {
      await target.fill(value, { force: true });
    }
  }
  {{/if}}

  {{#each resolvedSteps}}
  maestro.currentStep = {{step}};
  console.log('__STEP_START__ {{step}}');
  // Step {{step}}: {{#if description}}{{jsLit description}}{{else}}{{action}} -> {{jsLit targetLabel}}{{/if}}
  {{#if warning}}
  // [WARNING]: {{jsLit warning}}
  {{/if}}
  {{#if (eq action "fill")}}
    {{#if (eq selectorType "getByTestId")}}
  await page.getByTestId('{{jsLit selectorValue}}').fill('{{jsLit value}}', { force: true });
    {{else if (eq selectorType "getByLabel")}}
  await page.getByLabel('{{jsLit selectorValue}}', { exact: true }).fill('{{jsLit value}}', { force: true });
    {{else if (eq selectorType "getByRole")}}
  await page.getByRole('{{jsLit selectorValue}}', { name: '{{jsLit roleName}}', exact: true }).fill('{{jsLit value}}', { force: true });
    {{else if (eq selectorType "getByPlaceholder")}}
  await page.getByPlaceholder('{{jsLit selectorValue}}').fill('{{jsLit value}}', { force: true });
    {{else if (eq selectorType "getByText")}}
  await page.getByText('{{jsLit selectorValue}}').fill('{{jsLit value}}', { force: true });
    {{else}}
      {{#if ../needsRobustHelper}}
        {{#if targetLabel}}
  await action('fill', '{{jsLit targetLabel}}', '{{jsLit value}}');
        {{else}}
  await page.locator('{{jsLit selectorValue}}').fill('{{jsLit value}}', { force: true });
        {{/if}}
      {{else}}
  await page.locator('{{jsLit selectorValue}}').fill('{{jsLit value}}', { force: true });
      {{/if}}
    {{/if}}
  {{/if}}
  {{#if (eq action "click")}}
    {{#if options.within}}
  await scopedRow('{{jsLit options.within}}').assertResolvable();
    {{/if}}
    {{#if (eq selectorType "getByTestId")}}
  await {{{scopedLocJs (concat "page.getByTestId('" (jsLit selectorValue) "')") options.within}}}.click({ force: true });
    {{else if (eq selectorType "getByLabel")}}
  await {{{scopedLocJs (concat "page.getByLabel('" (jsLit selectorValue) "', { exact: true })") options.within}}}.click({ force: true });
    {{else if (eq selectorType "getByRole")}}
  await {{{scopedLocJs (concat "page.getByRole('" (jsLit selectorValue) "', { name: '" (jsLit roleName) "' })") options.within}}}.first().click({ force: true });
    {{else if (eq selectorType "getByPlaceholder")}}
  await {{{scopedLocJs (concat "page.getByPlaceholder('" (jsLit selectorValue) "')") options.within}}}.first().click({ force: true });
    {{else if (eq selectorType "getByText")}}
  await {{{scopedLocJs (concat "page.getByText('" (jsLit selectorValue) "')") options.within}}}.first().click({ force: true });
    {{else}}
  await {{{scopedLocJs (concat "page.locator('" (jsLit selectorValue) "')") options.within}}}.click({ force: true });
    {{/if}}
  // AC-07.12: a click may trigger a full-page navigation; wait for the page to
  // settle before the next step. Guarded so a non-navigating click just proceeds.
  await page.waitForLoadState('domcontentloaded', { timeout: 3000 }).catch(() => {});
  {{/if}}
  {{#if (eq action "select")}}
    {{#if (eq selectorType "getByTestId")}}
  await page.getByTestId('{{jsLit selectorValue}}').selectOption('{{jsLit value}}', { force: true });
    {{else if (eq selectorType "getByLabel")}}
  await page.getByLabel('{{jsLit selectorValue}}', { exact: true }).selectOption('{{jsLit value}}', { force: true });
    {{else}}
      {{#if ../needsRobustHelper}}
        {{#if targetLabel}}
  await action('select', '{{jsLit targetLabel}}', '{{jsLit value}}');
        {{else}}
  await page.locator('{{jsLit selectorValue}}').selectOption('{{jsLit value}}', { force: true });
        {{/if}}
      {{else}}
  await page.locator('{{jsLit selectorValue}}').selectOption('{{jsLit value}}', { force: true });
      {{/if}}
    {{/if}}
  {{/if}}
  {{#if (eq action "check")}}
    {{#if (eq selectorType "getByTestId")}}
  await page.getByTestId('{{jsLit selectorValue}}').check({ force: true });
    {{else if (eq selectorType "getByLabel")}}
  await page.getByLabel('{{jsLit selectorValue}}', { exact: true }).check({ force: true });
    {{else if (eq selectorType "getByRole")}}
  await page.getByRole('{{jsLit selectorValue}}', { name: '{{jsLit roleName}}', exact: true }).check({ force: true });
    {{else}}
  await page.locator('{{jsLit selectorValue}}').check({ force: true });
    {{/if}}
  {{/if}}
  {{#if (eq action "uncheck")}}
    {{#if (eq selectorType "getByTestId")}}
  await page.getByTestId('{{jsLit selectorValue}}').uncheck({ force: true });
    {{else if (eq selectorType "getByLabel")}}
  await page.getByLabel('{{jsLit selectorValue}}', { exact: true }).uncheck({ force: true });
    {{else}}
  await page.locator('{{jsLit selectorValue}}').uncheck({ force: true });
    {{/if}}
  {{/if}}
  {{#if (eq action "upload")}}
    {{#if (eq selectorType "getByTestId")}}
  await page.getByTestId('{{jsLit selectorValue}}').setInputFiles('{{jsLit value}}');
    {{else if (eq selectorType "getByLabel")}}
  await page.getByLabel('{{jsLit selectorValue}}', { exact: true }).setInputFiles('{{jsLit value}}');
    {{else if (eq selectorType "getByRole")}}
  await page.getByRole('{{jsLit selectorValue}}', { name: '{{jsLit roleName}}' }).first().setInputFiles('{{jsLit value}}');
    {{else if (eq selectorType "getByPlaceholder")}}
  await page.getByPlaceholder('{{jsLit selectorValue}}').setInputFiles('{{jsLit value}}');
    {{else}}
  await page.locator('{{jsLit selectorValue}}').setInputFiles('{{jsLit value}}');
    {{/if}}
  {{/if}}
  {{#if (eq action "assert_url")}}
  await expect(page).toHaveURL(new RegExp('{{jsLit selectorValue}}'));
  {{/if}}
  {{#if (eq action "assert_text")}}
    {{#if (eq selectorType "getByTestId")}}
  await expect(page.getByTestId('{{jsLit selectorValue}}')).toContainText('{{jsLit expected}}');
    {{else if (eq selectorType "getByLabel")}}
  await expect(page.getByLabel('{{jsLit selectorValue}}')).toContainText('{{jsLit expected}}');
    {{else if (eq selectorType "getByRole")}}
  await expect(page.getByRole('{{jsLit selectorValue}}', { name: '{{jsLit roleName}}' })).toContainText('{{jsLit expected}}');
    {{else if (eq selectorType "getByPlaceholder")}}
  await expect(page.getByPlaceholder('{{jsLit selectorValue}}')).toContainText('{{jsLit expected}}');
    {{else if (eq selectorType "getByText")}}
  await expect(page.getByText('{{jsLit selectorValue}}')).toContainText('{{jsLit expected}}');
    {{else if (eq selectorType "pageText")}}
  await assertTextOnPage('{{jsLit selectorValue}}');
    {{else}}
  await expect(page.locator('{{jsLit selectorValue}}')).toContainText('{{jsLit expected}}');
    {{/if}}
  {{/if}}
  {{#if (eq action "assert_visible")}}
    {{! AC-07.11: filter to a visible match first so a hidden twin element with }}
    {{! the same text/label does not fail the assertion falsely. }}
    {{#if (eq selectorType "getByTestId")}}
  await expect(page.getByTestId('{{jsLit selectorValue}}').filter({ visible: true }).first()).toBeVisible();
    {{else if (eq selectorType "getByLabel")}}
  await expect(page.getByLabel('{{jsLit selectorValue}}').filter({ visible: true }).first()).toBeVisible();
    {{else if (eq selectorType "getByRole")}}
  await expect(page.getByRole('{{jsLit selectorValue}}', { name: '{{jsLit roleName}}' }).filter({ visible: true }).first()).toBeVisible();
    {{else if (eq selectorType "getByPlaceholder")}}
  await expect(page.getByPlaceholder('{{jsLit selectorValue}}').filter({ visible: true }).first()).toBeVisible();
    {{else if (eq selectorType "getByText")}}
  await expect(page.getByText('{{jsLit selectorValue}}').filter({ visible: true }).first()).toBeVisible();
    {{else if (eq selectorType "pageText")}}
  await assertTextOnPage('{{jsLit selectorValue}}');
    {{else}}
  await expect(page.locator('{{jsLit selectorValue}}').filter({ visible: true }).first()).toBeVisible();
    {{/if}}
  {{/if}}
  {{#if (eq action "assert_value")}}
    {{#if (eq selectorType "getByTestId")}}
  await assertFieldValue(page.getByTestId('{{jsLit selectorValue}}'), '{{jsLit expected}}', '{{jsLit targetLabel}}');
    {{else if (eq selectorType "getByLabel")}}
  await assertFieldValue(page.getByLabel('{{jsLit selectorValue}}'), '{{jsLit expected}}', '{{jsLit targetLabel}}');
    {{else if (eq selectorType "getByRole")}}
  await assertFieldValue(page.getByRole('{{jsLit selectorValue}}', { name: '{{jsLit roleName}}' }), '{{jsLit expected}}', '{{jsLit targetLabel}}');
    {{else if (eq selectorType "getByPlaceholder")}}
  await assertFieldValue(page.getByPlaceholder('{{jsLit selectorValue}}'), '{{jsLit expected}}', '{{jsLit targetLabel}}');
    {{else}}
  await assertFieldValue(page.locator('{{jsLit selectorValue}}'), '{{jsLit expected}}', '{{jsLit targetLabel}}');
    {{/if}}
  {{/if}}
  {{#if (eq action "wait")}}
  await page.waitForTimeout({{selectorValue}});
  {{/if}}

  console.log('__STEP_DONE__ {{step}}');
  await maestro.captureStep({{step}});
  {{/each}}

  // All steps passed: capture the success snapshot (highlights the last match).
  await maestro.captureSuccess();
});
