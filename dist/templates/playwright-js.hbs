const { test, expect } = require('@playwright/test');

test('{{jsLit testSuite}}', async ({ page }) => {
  {{#if viewport}}
  await page.setViewportSize({ width: {{viewport.width}}, height: {{viewport.height}} });
  {{/if}}

  await page.goto('{{jsLit targetUrl}}');
  await page.waitForLoadState('networkidle');

  {{#if needsRobustHelper}}
  async function action(type, label, value) {
    const tag = type === 'select' ? 'select' : 'input';
    const escapedLabel = label.replace(/'/g, "\\'");
    
    // Standard XPath targeting following elements or descendants (handles labels wrapping inputs)
    const xpath = `xpath=((//*[normalize-space(.)='${escapedLabel}' or normalize-space(.)='${escapedLabel} *' or normalize-space(.)='${escapedLabel}*'])[1]/following::${tag}[1] | (//*[normalize-space(.)='${escapedLabel}' or normalize-space(.)='${escapedLabel} *' or normalize-space(.)='${escapedLabel}*'])[1]//${tag})[1]`;
    
    const target = page.locator(xpath);
    await target.waitFor({ state: 'attached', timeout: 15000 });
    
    if (type === 'select') {
      await target.selectOption(value, { force: true });
    } else {
      await target.fill(value, { force: true });
    }
  }
  {{/if}}

  {{#each resolvedSteps}}
  console.log('__STEP_START__ {{step}}');
  // Step {{step}}: {{#if description}}{{jsLit description}}{{else}}{{action}} -> {{jsLit targetLabel}}{{/if}}
  {{#if warning}}
  // [WARNING]: {{jsLit warning}}
  {{/if}}
  {{#if (eq action "fill")}}
    {{#if (eq selectorType "getByTestId")}}
  await page.getByTestId('{{jsLit selectorValue}}').fill('{{jsLit value}}', { force: true });
    {{else if (eq selectorType "getByLabel")}}
  await page.getByLabel('{{jsLit selectorValue}}', { exact: true }).fill('{{jsLit value}}', { force: true });
    {{else if (eq selectorType "getByRole")}}
  await page.getByRole('{{jsLit selectorValue}}', { name: '{{jsLit roleName}}', exact: true }).fill('{{jsLit value}}', { force: true });
    {{else if (eq selectorType "getByPlaceholder")}}
  await page.getByPlaceholder('{{jsLit selectorValue}}').fill('{{jsLit value}}', { force: true });
    {{else if (eq selectorType "getByText")}}
  await page.getByText('{{jsLit selectorValue}}').fill('{{jsLit value}}', { force: true });
    {{else}}
      {{#if ../needsRobustHelper}}
        {{#if targetLabel}}
  await action('fill', '{{jsLit targetLabel}}', '{{jsLit value}}');
        {{else}}
  await page.locator('{{jsLit selectorValue}}').fill('{{jsLit value}}', { force: true });
        {{/if}}
      {{else}}
  await page.locator('{{jsLit selectorValue}}').fill('{{jsLit value}}', { force: true });
      {{/if}}
    {{/if}}
  {{/if}}
  {{#if (eq action "click")}}
    {{#if (eq selectorType "getByTestId")}}
  await page.getByTestId('{{jsLit selectorValue}}').click({ force: true });
    {{else if (eq selectorType "getByLabel")}}
  await page.getByLabel('{{jsLit selectorValue}}', { exact: true }).click({ force: true });
    {{else if (eq selectorType "getByRole")}}
  await page.getByRole('{{jsLit selectorValue}}', { name: '{{jsLit roleName}}' }).first().click({ force: true });
    {{else if (eq selectorType "getByPlaceholder")}}
  await page.getByPlaceholder('{{jsLit selectorValue}}').first().click({ force: true });
    {{else if (eq selectorType "getByText")}}
  await page.getByText('{{jsLit selectorValue}}').first().click({ force: true });
    {{else}}
  await page.locator('{{jsLit selectorValue}}').click({ force: true });
    {{/if}}
  {{/if}}
  {{#if (eq action "select")}}
    {{#if (eq selectorType "getByTestId")}}
  await page.getByTestId('{{jsLit selectorValue}}').selectOption('{{jsLit value}}', { force: true });
    {{else if (eq selectorType "getByLabel")}}
  await page.getByLabel('{{jsLit selectorValue}}', { exact: true }).selectOption('{{jsLit value}}', { force: true });
    {{else}}
      {{#if ../needsRobustHelper}}
        {{#if targetLabel}}
  await action('select', '{{jsLit targetLabel}}', '{{jsLit value}}');
        {{else}}
  await page.locator('{{jsLit selectorValue}}').selectOption('{{jsLit value}}', { force: true });
        {{/if}}
      {{else}}
  await page.locator('{{jsLit selectorValue}}').selectOption('{{jsLit value}}', { force: true });
      {{/if}}
    {{/if}}
  {{/if}}
  {{#if (eq action "check")}}
    {{#if (eq selectorType "getByTestId")}}
  await page.getByTestId('{{jsLit selectorValue}}').check({ force: true });
    {{else if (eq selectorType "getByLabel")}}
  await page.getByLabel('{{jsLit selectorValue}}', { exact: true }).check({ force: true });
    {{else if (eq selectorType "getByRole")}}
  await page.getByRole('{{jsLit selectorValue}}', { name: '{{jsLit roleName}}', exact: true }).check({ force: true });
    {{else}}
  await page.locator('{{jsLit selectorValue}}').check({ force: true });
    {{/if}}
  {{/if}}
  {{#if (eq action "uncheck")}}
    {{#if (eq selectorType "getByTestId")}}
  await page.getByTestId('{{jsLit selectorValue}}').uncheck({ force: true });
    {{else if (eq selectorType "getByLabel")}}
  await page.getByLabel('{{jsLit selectorValue}}', { exact: true }).uncheck({ force: true });
    {{else}}
  await page.locator('{{jsLit selectorValue}}').uncheck({ force: true });
    {{/if}}
  {{/if}}
  {{#if (eq action "upload")}}
    {{#if (eq selectorType "getByTestId")}}
  await page.getByTestId('{{jsLit selectorValue}}').setInputFiles('{{jsLit value}}');
    {{else if (eq selectorType "getByLabel")}}
  await page.getByLabel('{{jsLit selectorValue}}', { exact: true }).setInputFiles('{{jsLit value}}');
    {{else if (eq selectorType "getByRole")}}
  await page.getByRole('{{jsLit selectorValue}}', { name: '{{jsLit roleName}}' }).first().setInputFiles('{{jsLit value}}');
    {{else if (eq selectorType "getByPlaceholder")}}
  await page.getByPlaceholder('{{jsLit selectorValue}}').setInputFiles('{{jsLit value}}');
    {{else}}
  await page.locator('{{jsLit selectorValue}}').setInputFiles('{{jsLit value}}');
    {{/if}}
  {{/if}}
  {{#if (eq action "assert_url")}}
  await expect(page).toHaveURL(new RegExp('{{jsLit selectorValue}}'));
  {{/if}}
  {{#if (eq action "assert_text")}}
    {{#if (eq selectorType "getByTestId")}}
  await expect(page.getByTestId('{{jsLit selectorValue}}')).toContainText('{{jsLit expected}}');
    {{else if (eq selectorType "getByLabel")}}
  await expect(page.getByLabel('{{jsLit selectorValue}}')).toContainText('{{jsLit expected}}');
    {{else if (eq selectorType "getByRole")}}
  await expect(page.getByRole('{{jsLit selectorValue}}', { name: '{{jsLit roleName}}' })).toContainText('{{jsLit expected}}');
    {{else if (eq selectorType "getByPlaceholder")}}
  await expect(page.getByPlaceholder('{{jsLit selectorValue}}')).toContainText('{{jsLit expected}}');
    {{else if (eq selectorType "getByText")}}
  await expect(page.getByText('{{jsLit selectorValue}}')).toContainText('{{jsLit expected}}');
    {{else}}
  await expect(page.locator('{{jsLit selectorValue}}')).toContainText('{{jsLit expected}}');
    {{/if}}
  {{/if}}
  {{#if (eq action "assert_visible")}}
    {{#if (eq selectorType "getByTestId")}}
  await expect(page.getByTestId('{{jsLit selectorValue}}')).toBeVisible();
    {{else if (eq selectorType "getByLabel")}}
  await expect(page.getByLabel('{{jsLit selectorValue}}')).toBeVisible();
    {{else if (eq selectorType "getByRole")}}
  await expect(page.getByRole('{{jsLit selectorValue}}', { name: '{{jsLit roleName}}' })).toBeVisible();
    {{else if (eq selectorType "getByPlaceholder")}}
  await expect(page.getByPlaceholder('{{jsLit selectorValue}}')).toBeVisible();
    {{else if (eq selectorType "getByText")}}
  await expect(page.getByText('{{jsLit selectorValue}}')).toBeVisible();
    {{else}}
  await expect(page.locator('{{jsLit selectorValue}}')).toBeVisible();
    {{/if}}
  {{/if}}
  {{#if (eq action "wait")}}
  await page.waitForTimeout({{selectorValue}});
  {{/if}}

  {{/each}}
});
